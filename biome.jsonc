{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Only code orqi owns. skills/ is replaced wholesale by `bun run vendor` and checked
		// against skills.lock.json; src/assets.generated.ts is written by build.ts; fixtures
		// are recorded server payloads. Markdown, themes and the lockfiles are left alone.
		"includes": ["src/**/*.ts", "*.ts", "npm/**/*.js", "npm/**/*.mjs", "!src/assets.generated.ts", "!src/fixtures"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		// 140, not the default 80: the code was written wide, and 140 touches about a third
		// fewer lines than 120 would while staying readable in a split editor.
		"lineWidth": 140
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				// pi's extension API, MCP payloads and test doubles are untyped at the boundary;
				// typing 115 sites is a refactor of its own, not a lint fix.
				"noExplicitAny": "off",
				// Stripping and matching ANSI escapes (\x1b) is the point of those regexes.
				"noControlCharactersInRegex": "off"
			},
			"style": {
				// Used after a length or lookup check the compiler cannot follow; replacing
				// 79 of them with guards would change control flow.
				"noNonNullAssertion": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	},
	"overrides": [
		{
			// The npm launcher and stager are plain Node scripts in their own house style.
			"includes": ["npm/**"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			},
			"javascript": {
				"formatter": {
					"quoteStyle": "single"
				}
			}
		},
		{
			// The launcher is CommonJS (no "type": "module") and declares node >=14, so its
			// 'use strict' is not redundant and require("node:...") would break Node < 14.18.
			"includes": ["npm/orqi/bin/orqi.js"],
			"linter": {
				"rules": {
					"suspicious": { "noRedundantUseStrict": "off" },
					"style": { "useNodejsImportProtocol": "off" }
				}
			}
		}
	]
}
