{
	"name": "orqi",
	"version": "0.22.2",
	"private": true,
	"type": "module",
	"description": "orqi - the orq.ai helper agent CLI: pi coding agent with orq MCP tools and skills built in",
	"bin": {
		"orqi": "./src/boot.ts"
	},
	"scripts": {
		"start": "bun src/boot.ts",
		"typecheck": "bun run assets && tsc --noEmit",
		"test": "bun test",
		"assets": "bun scripts/build.ts",
		"vendor": "bun scripts/vendor.ts",
		"build": "bun run assets && bun build --compile --outfile orqi src/boot.ts",
		"dist": "bun scripts/dist.ts",
		"format": "biome format --write",
		"format:check": "biome format",
		"lint": "biome lint",
		"lift-themes": "bun scripts/lift-themes.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.2.0",
		"@earendil-works/pi-coding-agent": "^1.2.0",
		"@earendil-works/pi-tui": "^1.2.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@spences10/pi-themes": "0.0.10",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"@biomejs/biome": "2.5.15"
	}
}
