{
  "name": "orqi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "orqi - the orq.ai helper agent CLI: pi coding agent with orq MCP tools and skills built in",
  "bin": {
    "orqi": "./src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "bun run assets && tsc --noEmit",
    "test": "bun test",
    "assets": "bun build.ts",
    "vendor": "bun vendor.ts",
    "build": "bun run assets && bun build --compile --outfile orqi src/main.ts",
    "dist": "bun dist.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}